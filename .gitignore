# This repo bundles fabric-x-samples (the tokens sample app) and drunix
# (+ drunix-network, the backing network for the drunix PLATFORM option)
# as plain source. Everything regenerated by `make install-prerequisites`,
# `make setup`, or a drunix build is excluded on purpose.

# Hyperledger fabric-samples, downloaded fresh by install-fabric.sh
fabric-x-samples/tokens/fabric-samples/

# drunix build output (compiled binaries, Docker build context/release tarballs)
drunix/build/
drunix/release/

# drunix's own convention for local reference notes (already gitignored inside drunix itself)
drunix/notes/

# ansible-galaxy collection download cache + local venv (tokens/fabricx platform)
fabric-x-samples/tokens/ansible/collections/
fabric-x-samples/tokens/ansible/.venv/

# generated crypto / runtime data under any conf*/ dir, any platform
**/conf/*/keys/
**/conf/*/data/
**/conf-f3/*/keys/
**/conf-f3/*/data/
**/conf-drunix/*/keys/
**/conf-drunix/*/data/
**/conf/namespace/*.json
**/conf-f3/namespace/*.json
**/conf-drunix/namespace/*.json

# drunix-network test-network generated artifacts
**/drunix-network/test-network/organizations/
**/drunix-network/test-network/channel-artifacts/
**/drunix-network/test-network/log.txt
**/drunix-network/test-network/*.tar.gz

# fabric-samples test-network generated artifacts (fabric3 platform, if ever vendored)
**/fabric-samples/test-network/organizations/
**/fabric-samples/test-network/channel-artifacts/

.DS_Store

# local Claude Code state
**/.claude/
